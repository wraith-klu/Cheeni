# ── Cheeni Agent — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to git.

# LLM Keys (get free tier from each)
GEMINI_API_KEY=your_gemini_api_key_here        # aistudio.google.com — 1500 req/day free
GROQ_API_KEY=your_groq_api_key_here            # console.groq.com — 14400 req/day free
OPENROUTER_API_KEY=your_openrouter_key_here    # openrouter.ai — free models available

# HuggingFace (get from hf.co/settings/tokens)
HF_TOKEN=your_hf_token_here
HF_REPO_PREFIX=wraith-klu/cheeni-

# Environment
ENVIRONMENT=local                              # local | production
PORT=2026

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: for large local models via Ollama
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_PERSONA_MODEL=phi3.5:mini
