PORT=2025
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# Shared secret for the local Node-to-Python desktop agent bridge.
# Set the same strong random value in cheeni-agent/.env as AGENT_API_TOKEN.
AGENT_API_TOKEN=replace_with_at_least_32_random_characters

# Multi-step desktop task execution; enable only after reviewing the workflow gates.
TASK_EXECUTION_ENABLED=false

# MongoDB Connection
MONGODB_URL=mongodb://127.0.0.1:27017/CheeniDB

# JWT Secrets
JWT_SECRET=your_legacy_jwt_secret_here
JWT_ACCESS_SECRET=your_jwt_access_secret_64_bytes_hex
JWT_REFRESH_SECRET=your_jwt_refresh_secret_64_bytes_hex
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary Credentials (for avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# LLM Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free

# Optional: Google Gemini API Key (secondary fallback if OpenRouter is unreachable)
# GEMINI_API_KEY=your_gemini_api_key_here

# Conversation Context Window Size (default: 25)
CONTEXT_WINDOW_SIZE=25

# ── Phase 7: Connected Services (Google Calendar) ──────────────────────────
# OAuth 2.0 credentials from https://console.cloud.google.com/
# Redirect URI must be registered: http://localhost:2025/api/integrations/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:2025/api/integrations/callback

# 32-byte (64 hex chars) random key for AES-256-GCM token encryption at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHEENI_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here
